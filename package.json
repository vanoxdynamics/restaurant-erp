{
  "name": "restaurant-erp",
  "private": true,
  "description": "Enterprise Restaurant ERP Monorepo",
  "scripts": {
    "generate:api": "pnpm --filter @restaurant-erp/api-client generate",
    "lint": "pnpm -r --parallel lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "pnpm -r --parallel typecheck"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
