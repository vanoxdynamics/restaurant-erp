    "@repo/shared-utils": "workspace:*",
    "@tanstack/react-query": "^5.28.0",
    "expo": "~57.0.0",
    "expo-font": "~57.0.4",
    "expo-print": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.4",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
