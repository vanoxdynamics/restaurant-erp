{
  "expo": {
    "name": "Restaurant Admin",
    "slug": "restaurant-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a logo to print on your bills.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
