# Monorepo Environment Variables

# PostgreSQL 16 Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=restaurant_erp
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/restaurant_erp

# Redis 7 Configuration
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Backend API Configuration
API_PORT=8000
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=restaurant-erp-insecure-dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19000,http://localhost:19006
