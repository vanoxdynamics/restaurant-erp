# FastAPI Application Environment (development | test | staging | production)
ENVIRONMENT=development
DEBUG=False
DB_ECHO=False
PROJECT_NAME="Restaurant ERP API"
API_V1_STR=/api/v1

# Security — outside development/test both must be unique values of 32+ characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
PIN_PEPPER=dev-pin-pepper-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# Platform operator console — outside development/test all must be unique values of 32+ characters.
PLATFORM_SECRET_KEY=dev-platform-secret-change-in-production-min-32-chars
PLATFORM_ENCRYPTION_KEY=dev-platform-enc-key-change-in-production-min-32-chars
PLATFORM_COOKIE_SECURE=true
# Operator sessions (minutes/hours) and how long a password + code re-check unlocks sensitive actions.
PLATFORM_SESSION_IDLE_MINUTES=60
PLATFORM_SESSION_ABSOLUTE_HOURS=12
PLATFORM_STEP_UP_MINUTES=60
# true: dangerous actions (platform-wide module switch, bulk changes, immediate cancellation) need a second super admin.
PLATFORM_FOUR_EYES=false
# While rotating PLATFORM_ENCRYPTION_KEY: list the previous key(s) here, run `python -m app.cli rotate-encryption-key`, then remove them.
PLATFORM_ENCRYPTION_KEYS_OLD=
# Comma-separated CIDRs allowed to reach /platform (empty = unrestricted). Example: 203.0.113.0/24,10.0.0.0/8
PLATFORM_IP_ALLOWLIST=

# Business rules
DEFAULT_TIMEZONE=Asia/Kolkata
DISCOUNT_APPROVAL_THRESHOLD_PERCENT=10
CASH_VARIANCE_ALERT_THRESHOLD=100.00

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/restaurant_erp

# Redis
REDIS_URL=redis://localhost:6379/0

# Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19000,http://localhost:19006
