# FastAPI Application Environment (development | test | staging | production)
ENVIRONMENT=development
DEBUG=False
DB_ECHO=False
PROJECT_NAME="Restaurant ERP API"
API_V1_STR=/api/v1

# Security — outside development/test both must be unique values of 32+ characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
PIN_PEPPER=dev-pin-pepper-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# Business rules
DEFAULT_TIMEZONE=Asia/Kolkata
DISCOUNT_APPROVAL_THRESHOLD_PERCENT=10
CASH_VARIANCE_ALERT_THRESHOLD=100.00

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/restaurant_erp

# Redis
REDIS_URL=redis://localhost:6379/0

# Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19000,http://localhost:19006
